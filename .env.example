# Copy this file to .env if you need to set any local environment variables.

# AWS credentials for Bedrock (or configure via `aws configure` / IAM role instead)
AWS_REGION=us-west-2

# Required before deploying this app anywhere public. Every visitor's use of
# the dashboard's "Run Agent Now" / "Submit Payment" / "Calculate Payout" /
# "Resolve" buttons calls Bedrock using THIS server's AWS credentials, not
# the visitor's own - there is no per-visitor billing separation. Set this to
# a real shared secret and give it only to people you want able to trigger
# those calls; the app falls back to a well-known default ("chama-demo") if
# unset, which is fine for local-only testing but not for a public URL.
DEMO_ACCESS_TOKEN=change-me-before-deploying
